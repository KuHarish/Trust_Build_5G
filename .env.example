# TrustChain-5G Enterprise Platform - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your deployment environment

# ==============================================================================
# GENERAL APPLICATION SETTINGS
# ==============================================================================
PROJECT_NAME="TrustChain-5G"
ENVIRONMENT="development" # development | staging | production
DEBUG=true
API_VERSION="v1"

# ==============================================================================
# DATABASE CONFIGURATION (MONGODB / MOTOR)
# ==============================================================================
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="trustchain_5g"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
JWT_SECRET_KEY="super-secret-enterprise-key-replace-in-production-with-256-bit-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# ==============================================================================
# FRONTEND CONFIGURATION (VITE ENV)
# ==============================================================================
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_NAME="TrustChain-5G"
VITE_ENABLE_MOCK_AUTH=true
VITE_DEFAULT_THEME="dark"

# ==============================================================================
# SIMULATION & FUTURE SPRINT FLAGS
# ==============================================================================
ENABLE_NETWORK_SIMULATOR=false
ENABLE_ML_DETECTION_ENGINE=false
ENABLE_FEDERATED_LEARNING=false
ENABLE_BLOCKCHAIN_STORAGE=false
ENABLE_ADAPTIVE_TRUST_ENGINE=false
