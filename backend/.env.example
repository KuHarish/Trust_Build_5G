# TrustChain-5G Backend Environment Settings
PROJECT_NAME="TrustChain-5G Backend Engine"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# MongoDB Database Settings
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="trustchain_5g_db"

# JWT Security
JWT_SECRET_KEY="trustchain_5g_enterprise_secret_key_change_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (JSON formatted array of strings or simple comma separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
